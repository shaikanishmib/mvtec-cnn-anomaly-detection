{
  "openapi": "3.1.0",
  "info": {
    "title": "Industrial anomaly inspection research API",
    "description": "Research use only. Raw anomaly distances are not probabilities; frozen normal-only cutoffs can have substantial category-dependent false alarms and misses.",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Live",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Ready",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "summary": "Models",
        "operationId": "models_api_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "summary": "Categories",
        "operationId": "categories_api_v1_categories_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/model-info": {
      "get": {
        "summary": "Info",
        "operationId": "info_api_v1_model_info_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "bottle",
              "title": "Category"
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "patchcore",
              "title": "Model"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "408": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Timeout"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/v1/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_api_v1_predict_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "bottle",
                      "cable",
                      "capsule",
                      "carpet",
                      "grid",
                      "hazelnut",
                      "leather",
                      "metal_nut",
                      "pill",
                      "screw",
                      "tile",
                      "toothbrush",
                      "transistor",
                      "wood",
                      "zipper"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "enum": [
                      "patchcore"
                    ],
                    "default": "patchcore"
                  },
                  "visualize": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "type": "object",
                "required": [
                  "image",
                  "category"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "408": {
            "description": "Request Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predictions/{prediction_id}/heatmap": {
      "get": {
        "summary": "Heatmap",
        "operationId": "heatmap_api_v1_predictions__prediction_id__heatmap_get",
        "parameters": [
          {
            "name": "prediction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Prediction Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/v1/predictions/{prediction_id}/overlay": {
      "get": {
        "summary": "Overlay",
        "operationId": "overlay_api_v1_predictions__prediction_id__overlay_get",
        "parameters": [
          {
            "name": "prediction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Prediction Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "PredictionResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "prediction_id": {
            "type": "string",
            "title": "Prediction Id"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "model": {
            "type": "string",
            "const": "patchcore",
            "title": "Model",
            "default": "patchcore"
          },
          "model_version": {
            "type": "string",
            "const": "patchcore-inference-v1",
            "title": "Model Version",
            "default": "patchcore-inference-v1"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "anomaly_score": {
            "type": "number",
            "title": "Anomaly Score"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "is_anomaly": {
            "type": "boolean",
            "title": "Is Anomaly"
          },
          "pixel_threshold": {
            "type": "number",
            "title": "Pixel Threshold"
          },
          "decision_rule": {
            "type": "string",
            "const": "score > threshold",
            "title": "Decision Rule",
            "default": "score > threshold"
          },
          "score_semantics": {
            "type": "string",
            "title": "Score Semantics",
            "default": "Raw L2 distance; higher is more anomalous; not a probability"
          },
          "input_width": {
            "type": "integer",
            "title": "Input Width"
          },
          "input_height": {
            "type": "integer",
            "title": "Input Height"
          },
          "device": {
            "type": "string",
            "title": "Device"
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Latency Ms"
          },
          "timings_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Timings Ms"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "visualizations": {
            "$ref": "#/components/schemas/Visualizations"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "prediction_id",
          "request_id",
          "category",
          "anomaly_score",
          "threshold",
          "is_anomaly",
          "pixel_threshold",
          "input_width",
          "input_height",
          "device",
          "latency_ms",
          "timings_ms",
          "provenance",
          "visualizations"
        ],
        "title": "PredictionResponse"
      },
      "Provenance": {
        "properties": {
          "manifest_sha256": {
            "type": "string",
            "title": "Manifest Sha256"
          },
          "bank_sha256": {
            "type": "string",
            "title": "Bank Sha256"
          },
          "extractor_sha256": {
            "type": "string",
            "title": "Extractor Sha256"
          },
          "pretrained_weight_sha256": {
            "type": "string",
            "title": "Pretrained Weight Sha256"
          },
          "calibration_sha256": {
            "type": "string",
            "title": "Calibration Sha256"
          },
          "preprocessing_sha256": {
            "type": "string",
            "title": "Preprocessing Sha256"
          },
          "seed": {
            "type": "integer",
            "const": 2026,
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "manifest_sha256",
          "bank_sha256",
          "extractor_sha256",
          "pretrained_weight_sha256",
          "calibration_sha256",
          "preprocessing_sha256",
          "seed"
        ],
        "title": "Provenance"
      },
      "Visualizations": {
        "properties": {
          "heatmap_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heatmap Url"
          },
          "overlay_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overlay Url"
          },
          "expires_in_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires In Seconds"
          },
          "scaling": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scaling"
          }
        },
        "type": "object",
        "title": "Visualizations"
      }
    }
  }
}
